#!/bin/sh /etc/rc.common
# WorkBuddy relay service for OpenWrt

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/workbuddy-server
LOG=/var/log/workbuddy.log

start_service() {
	config_load workbuddy
	config_get_bool enabled main enabled 0
	[ "$enabled" = "1" ] || return 0

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="4096 4096"
	procd_close_instance
}

stop_service() {
	# procd terminates the tracked process; nothing extra is required.
	:
}

reload_service() {
	stop
	start
}
