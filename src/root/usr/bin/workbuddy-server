#!/bin/sh
# WorkBuddy relay server for OpenWrt
# Exposes an OpenAI-compatible endpoint backed by WorkBuddy free models.
# Runs on ash + ucode (uses ucode's socket/http for the listener).

WORKBUDDY_LIB=/usr/share/workbuddy/workbuddy.uc
WORKBUDDY_CFG=workbuddy

. /lib/functions.sh

config_load "$WORKBUDDY_CFG"

config_get_bool enabled main enabled 0
config_get host       main listen_host  '0.0.0.0'
config_get port       main listen_port  '8789'
config_get token      main access_token ''
config_get endpoint   main endpoint     'https://www.workbuddy.ai'
config_get cver       main client_version '5.5.2'
config_get_bool free_only   main free_only   1
config_get share_token main share_token ''
config_get expose_models   main expose_models ''
config_get_bool debug  main debug 0

[ "$enabled" = "1" ] || { echo "workbuddy: disabled in config"; exit 0; }

export WORKBUDDY_HOST="$host"
export WORKBUDDY_PORT="$port"
export WORKBUDDY_TOKEN="$token"
export WORKBUDDY_ENDPOINT="$endpoint"
export WORKBUDDY_CLIENT_VERSION="$cver"
export WORKBUDDY_FREE_ONLY="$free_only"
export WORKBUDDY_SHARE_TOKEN="$share_token"
export WORKBUDDY_EXPOSE_MODELS="$expose_models"
export WORKBUDDY_DEBUG="$debug"

exec ucode -L "$WORKBUDDY_LIB"
